{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whetstone.local/schemas/product_event.schema.json",
  "title": "Whetstone product event (events.jsonl)",
  "description": "One immutable, append-only record per line. State is DERIVED by replay; never mutate. Distinct from build_evidence.jsonl. This schema ENFORCES the required evidence payload per kind; a wrong or empty payload for a kind must fail validation. Cross-field invariants that JSON Schema cannot express (e.g. transferred.from_repo_id != to_repo_id) are enforced by spec/validate_event.py.",
  "type": "object",
  "required": [
    "event_id", "ts", "kind", "principle_id", "principle_version", "repo_id",
    "host", "session_id", "evidence",
    "schema_version", "whetstone_version", "policy_version", "detector_version",
    "model_id", "mapping_prompt_hash", "worktree_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "pattern": "^e_"},
    "ts": {"type": "integer"},
    "kind": {"$ref": "#/$defs/kind"},
    "principle_id": {"type": "string", "pattern": "^p_"},
    "principle_version": {"type": "integer", "minimum": 1},
    "repo_id": {"type": "string", "pattern": "^r_"},
    "local_path": {"type": "string"},
    "head": {"type": "string"},
    "host": {"type": "string", "enum": ["claude_code", "codex", "other"]},
    "session_id": {"type": "string"},
    "confidence": {"type": ["number", "null"]},
    "evidence": {"type": "object"},
    "schema_version": {"const": 1},
    "whetstone_version": {"type": ["string", "null"]},
    "policy_version": {"type": ["string", "null"]},
    "detector_version": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "mapping_prompt_hash": {"type": ["string", "null"]},
    "worktree_sha256": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "proposed"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_proposed"}}}},
    {"if": {"properties": {"kind": {"const": "accepted"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_finding_only"}}}},
    {"if": {"properties": {"kind": {"const": "rejected"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_finding_reason_nullable"}}}},
    {"if": {"properties": {"kind": {"const": "lesson_deferred"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_finding_no_response"}}}},
    {"if": {"properties": {"kind": {"const": "already_known"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_finding_reason_nullable"}}}},
    {"if": {"properties": {"kind": {"const": "deliberately_omitted"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_deliberately_omitted"}}}},
    {"if": {"properties": {"kind": {"const": "already_handled"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_already_handled"}}}},
    {"if": {"properties": {"kind": {"const": "forgot_to_apply"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_forgot_to_apply"}}}},
    {"if": {"properties": {"kind": {"const": "applied"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_applied"}}}},
    {"if": {"properties": {"kind": {"const": "applied_again"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_applied_again"}}}},
    {"if": {"properties": {"kind": {"const": "opportunity_detected"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_opportunity_detected"}}}},
    {"if": {"properties": {"kind": {"const": "recall_prompted"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_opportunity_only"}}}},
    {"if": {"properties": {"kind": {"const": "direction_recalled"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_direction_recalled"}}}},
    {"if": {"properties": {"kind": {"const": "recall_deferred"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_opportunity_no_response"}}}},
    {"if": {"properties": {"kind": {"const": "recall_unmatched"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_recall_unmatched"}}}},
    {"if": {"properties": {"kind": {"const": "practice_present"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_practice_present"}}}},
    {"if": {"properties": {"kind": {"const": "transferred"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_transferred"}}}},
    {"if": {"properties": {"kind": {"const": "needs_verification"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_finding_reason_required"}}}},
    {"if": {"properties": {"kind": {"const": "expired"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/ev_expired"}}}}
  ],
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "proposed", "accepted", "rejected", "lesson_deferred",
        "already_known", "deliberately_omitted", "already_handled", "forgot_to_apply",
        "applied", "applied_again", "opportunity_detected", "recall_prompted",
        "direction_recalled", "recall_deferred", "recall_unmatched",
        "practice_present", "transferred", "repeated_unaided_transfer",
        "needs_verification", "expired"
      ]
    },
    "ev_proposed": {"type": "object", "required": ["finding_id", "classification"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "classification": {"enum": ["confirmed", "partial"]}, "repository_evidence": {"type": "array"}}},
    "ev_finding_only": {"type": "object", "required": ["finding_id"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "user_reason": {"type": ["string", "null"]}}},
    "ev_finding_reason_nullable": {"type": "object", "required": ["finding_id"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "user_reason": {"type": ["string", "null"]}}},
    "ev_finding_no_response": {"type": "object", "required": ["finding_id", "reason"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "reason": {"const": "no_response"}}},
    "ev_deliberately_omitted": {"type": "object", "required": ["finding_id", "user_reason"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "user_reason": {"type": "string", "minLength": 1}}},
    "ev_already_handled": {"type": "object", "required": ["finding_id", "repository_evidence"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "repository_evidence": {"type": "array"}}},
    "ev_forgot_to_apply": {"type": "object", "required": ["opportunity_id", "reported_by"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "reported_by": {"const": "user"}, "user_reason": {"type": ["string", "null"]}}},
    "ev_applied": {"type": "object", "required": ["finding_id", "tell_id", "worktree_sha256"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "tell_id": {"type": "string"}, "worktree_sha256": {"type": "string"}}},
    "ev_applied_again": {"type": "object", "required": ["finding_id", "tell_id"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "tell_id": {"type": "string"}}},
    "ev_opportunity_detected": {"type": "object", "required": ["opportunity_id", "repo_id", "detector_version"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "repo_id": {"type": "string"}, "diff_scope": {"type": "string"}, "detector_version": {"type": "string"}}},
    "ev_opportunity_only": {"type": "object", "required": ["opportunity_id"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "risk_snapshot": {"type": "object"}}},
    "ev_direction_recalled": {"type": "object", "required": ["opportunity_id", "direction_id", "excerpt_sha256"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "direction_id": {"type": "string"}, "excerpt_sha256": {"type": "string"}}},
    "ev_opportunity_no_response": {"type": "object", "required": ["opportunity_id", "reason"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "reason": {"const": "no_response"}}},
    "ev_recall_unmatched": {"type": "object", "required": ["opportunity_id", "direction_id", "reason"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "direction_id": {"type": "string"}, "reason": {"const": "matcher_failed"}}},
    "ev_practice_present": {"type": "object", "required": ["opportunity_id", "tell_id"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string"}, "tell_id": {"type": "string"}}},
    "ev_transferred": {"type": "object", "required": ["opportunity_id", "direction_id", "tell_id", "from_repo_id", "to_repo_id"], "additionalProperties": false,
      "properties": {"opportunity_id": {"type": "string", "minLength": 1}, "direction_id": {"type": "string", "minLength": 1}, "tell_id": {"type": "string", "minLength": 1}, "from_repo_id": {"type": "string", "pattern": "^r_"}, "to_repo_id": {"type": "string", "pattern": "^r_"}}},
    "ev_finding_reason_required": {"type": "object", "required": ["finding_id", "reason"], "additionalProperties": false,
      "properties": {"finding_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}},
    "ev_expired": {"type": "object", "required": ["principle_id", "old_version", "new_version"], "additionalProperties": false,
      "properties": {"principle_id": {"type": "string"}, "old_version": {"type": "integer"}, "new_version": {"type": "integer"}}}
  }
}
